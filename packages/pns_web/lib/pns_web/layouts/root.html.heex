<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={Plug.CSRFProtection.get_csrf_token()} />
    <title>PNS Dashboard</title>
    <link rel="stylesheet" href="/pns_web/assets/app.css" />
    <!-- Loaded before app.js, both deferred: app.js's own comment explains
         why this has to be a classic script tag, not an esbuild import. -->
    <script defer src="/pns_web/assets/mermaid.min.js">
    </script>
    <script defer src="/pns_web/assets/app.js">
    </script>
  </head>
  <body>
    <main>{@inner_content}</main>
  </body>
</html>
