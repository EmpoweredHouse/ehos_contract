{
  "schema": "ehos.manifest/v3",
  "ehos_yaml": "ehos.yaml/v3",
  "application": "ledger",
  "needs": {
    "people": "read"
  },
  "offers": {
    "capabilities": [
      {
        "name": "ledger.flag_entry",
        "command": "flag_entry",
        "label": "Flag an entry",
        "process": "entries",
        "principals": [
          "human"
        ]
      },
      {
        "name": "ledger.record_entry",
        "command": "record_entry",
        "label": "Record an entry",
        "process": "entries",
        "principals": [
          "human"
        ]
      }
    ],
    "roles": [
      {
        "name": "ledger.auditor",
        "label": "Auditor",
        "capabilities": [
          "ledger.flag_entry"
        ]
      },
      {
        "name": "ledger.clerk",
        "label": "Clerk",
        "capabilities": [
          "ledger.record_entry"
        ]
      }
    ]
  },
  "serves": [
    {
      "name": "web",
      "port": 4000,
      "public": true
    }
  ],
  "sign_in": {},
  "health": {
    "port": 4001,
    "ready": "/health/ready",
    "live": "/health/live"
  }
}
