{
  "schema": "ehos.manifest/v2",
  "ehos_yaml": "ehos.yaml/v1",
  "application": "ledger",
  "offers": {
    "capabilities": [
      {
        "name": "ledger.flag_entry",
        "command": "flag_entry",
        "label": "Flag an entry",
        "process": "entries",
        "principals": ["human"]
      },
      {
        "name": "ledger.record_entry",
        "command": "record_entry",
        "label": "Record an entry",
        "process": "entries",
        "principals": ["human"]
      }
    ],
    "roles": [
      {
        "name": "ledger.auditor",
        "label": "Auditor",
        "capabilities": ["ledger.flag_entry"]
      },
      {
        "name": "ledger.clerk",
        "label": "Clerk",
        "capabilities": ["ledger.record_entry"]
      }
    ]
  },
  "needs": {
    "database": {
      "engine": "postgres",
      "version": ">= 16",
      "migrate": ["/app/bin/migrate"]
    }
  },
  "serves": [{"name": "web", "port": 4000, "public": true}],
  "health": {"port": 4001, "ready": "/health/ready", "live": "/health/live"}
}
