{
  "schema": "ehos.manifest/v6",
  "ehos_yaml": "ehos.yaml/v5",
  "application": "ledger",
  "needs": {
    "database": {
      "engine": "postgres",
      "migrate": [
        "/app/bin/migrate"
      ]
    },
    "egress": [
      {
        "host": "registry.example.org"
      },
      {
        "host": "mail.example.net",
        "port": 587
      }
    ]
  },
  "offers": {
    "capabilities": [
      {
        "name": "ledger.flag_entry",
        "command": "flag_entry",
        "label": "Flag an entry",
        "principals": [
          "human"
        ]
      },
      {
        "name": "ledger.record_entry",
        "command": "record_entry",
        "label": "Record an entry",
        "principals": [
          "human"
        ]
      }
    ],
    "roles": [
      {
        "name": "ledger.auditor",
        "label": "Auditor",
        "capabilities": [
          "ledger.flag_entry"
        ]
      },
      {
        "name": "ledger.clerk",
        "label": "Clerk",
        "capabilities": [
          "ledger.record_entry"
        ]
      }
    ]
  },
  "serves": [
    {
      "name": "web",
      "port": 4000,
      "public": true
    }
  ],
  "health": {
    "port": 4001,
    "ready": "/health/ready",
    "live": "/health/live"
  }
}
