{
  "schema": "ehos.manifest/v7",
  "ehos_yaml": "ehos.yaml/v6",
  "application": "ledger",
  "needs": {
    "database": {
      "engine": "postgres",
      "migrate": [
        "/app/bin/migrate"
      ]
    },
    "mail": {
      "level": "external",
      "reply_domains": [
        "reply.office.example.org",
        "answers.example.net"
      ]
    }
  },
  "offers": {
    "capabilities": [
      {
        "name": "ledger.flag_entry",
        "command": "flag_entry",
        "label": "Flag an entry",
        "principals": [
          "human"
        ]
      },
      {
        "name": "ledger.record_entry",
        "command": "record_entry",
        "label": "Record an entry",
        "principals": [
          "human"
        ]
      }
    ],
    "roles": [
      {
        "name": "ledger.auditor",
        "label": "Auditor",
        "capabilities": [
          "ledger.flag_entry"
        ]
      },
      {
        "name": "ledger.clerk",
        "label": "Clerk",
        "capabilities": [
          "ledger.record_entry"
        ]
      }
    ]
  },
  "serves": [
    {
      "name": "web",
      "port": 4000,
      "public": true
    }
  ],
  "health": {
    "port": 4001,
    "ready": "/health/ready",
    "live": "/health/live"
  }
}
