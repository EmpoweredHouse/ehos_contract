flowchart TB
    subgraph stage_start["start"]
        visit_started["Pacjent wszedł do gabinetu"]
    end
    subgraph stage_departure["departure"]
        visit_completed["Pacjent wyszedł z gabinetu"]
    end
    subgraph stage_closing["closing · no order claimed inside"]
        visit_closed_clinically["Zamknięto wizytę przez specjalistę"]
        documentation_task_created["Utworzono zadanie: dokumentacja wizyty do uzupełnienia"]
    end
    subgraph stage_reporting["reporting · no order claimed inside"]
        p1_reporting_not_required["Usługa nie podlega zgłoszeniu do rejestru zdarzeń medycznych"]
        p1_report_sent["Wysłano zgłoszenie zdarzenia medycznego do P1"]
        p1_report_failed["Zgłoszenie do P1 odrzucone albo nie doszło do rejestru"]
    end
    stage_start --> stage_departure
    stage_departure --> stage_closing
    stage_closing --> stage_reporting
    visit_completed ==>|within 24 hours| p1_report_sent
    visit_completed -.->|or else| documentation_task_created
    visit_completed ==>|within 2 days| p1_report_sent
    visit_completed -.->|or else| p1_reporting_not_required
    medical_event_registry[("Krajowy rejestr zdarzeń medycznych (P1)")]
    p1_report_sent -.- medical_event_registry
    p1_report_failed -.- medical_event_registry
    class p1_reporting_not_required,p1_report_sent terminal
    class medical_event_registry external
    classDef terminal fill:#c8e6c9,stroke:#2e7d32,color:#000
    classDef external fill:#eceff1,stroke:#546e7a,color:#000,stroke-dasharray: 4 3