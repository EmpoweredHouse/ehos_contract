sandbox/_build/
sandbox/cover/
sandbox/deps/
sandbox/doc/
sandbox/tmp/
# ExUnit's `@tag :tmp_dir` in the auth package's manifest task tests.
packages/ehos_contract_auth/tmp/
# The package builds and fetches on its own when it is the top-level project —
# `cd packages/ehos_contract && mix test` is the proof that the seam is real, and it
# produces a build tree of its own. Root-anchored patterns do not reach it.
packages/*/_build/
packages/*/cover/
packages/*/deps/
# `mix docs` without `--output` in a package.
packages/*/doc/
/.fetch
erl_crash.dump
*.ez
*.beam
sandbox/config/*.secret.exs
.elixir_ls/
# A maintainer's own Claude Code settings (CONTRIBUTING.md, "Working with Claude Code").
.claude/settings.local.json
